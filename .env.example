# ==========================================
# Dr. Anand's Dental Clinic - Environment Config
# ==========================================

# SMTP Mailer Settings (Configured for Gmail SMTP)
# Obtain a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-actual-email@gmail.com
SMTP_PASS=your-16-digit-app-password
SMTP_FROM="Dr. Anand's Dental Clinic <your-actual-email@gmail.com>"
